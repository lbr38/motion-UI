#: controllers/Layout/Chart/vars/motion-event-chart.vars.inc.php
msgid "Events"
msgstr "Événements"

#: controllers/Layout/Chart/vars/motion-event-chart.vars.inc.php
msgid "Media files recorded"
msgstr "Fichiers médias enregistrés"

#: controllers/Layout/Chart/vars/motion-status-chart.vars.inc.php
msgid "Motion detection activity"
msgstr "Activité de détection de mouvement"

#: controllers/Layout/Chart/vars/system-cpu-usage-chart.vars.inc.php
#: views/includes/containers/buttons/top.inc.php
msgid "CPU usage"
msgstr "Utilisation CPU"

#: controllers/Layout/Chart/vars/system-disk-usage-chart.vars.inc.php
msgid "Disk usage"
msgstr "Utilisation disque"

#: controllers/Layout/Chart/vars/system-memory-usage-chart.vars.inc.php
msgid "Memory usage"
msgstr "Utilisation mémoire"

#: controllers/Layout/Container/vars/login.vars.inc.php
msgid "Invalid login and/or password"
msgstr "Identifiant et/ou mot de passe invalide"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "CAMERA DEVICE SETTINGS"
msgstr "PARAMÈTRES DU PÉRIPHÉRIQUE CAMÉRA"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "DEVICE ID"
msgstr "ID DU PÉRIPHÉRIQUE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Camera device ID"
msgstr "ID du périphérique caméra"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "DEVICE NAME"
msgstr "NOM DU PÉRIPHÉRIQUE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Camera device name"
msgstr "Nom du périphérique caméra"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "CAMERA DEVICE"
msgstr "PÉRIPHÉRIQUE CAMÉRA"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The v4l2 device to be used for capturing. Example: <code>/dev/video0</code>."
msgstr ""
"Le périphérique v4l2 à utiliser pour la capture. Exemple : <code>/dev/"
"video0</code>."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "V4L2 PARAMETERS"
msgstr "PARAMÈTRES V4L2"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Comma separated list of configuration parameters (aka controls) for the v4l2 "
"device."
msgstr ""
"Liste de paramètres de configuration (aussi appelés contrôles) du "
"périphérique v4l2, séparés par des virgules."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "NETWORK CAMERA URL"
msgstr "URL DE LA CAMÉRA RÉSEAU"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Network camera URL, used for the motion detection. If your camera has a "
"secondary stream with a lower resolution, it is recommended to use the low "
"resolution stream for motion detection and the high resolution stream for "
"recording (see NETWORK CAMERA HIGH RESOLUTION URL)."
msgstr ""
"URL de la caméra réseau, utilisée pour la détection de mouvement. Si votre "
"caméra dispose d'un flux secondaire de plus faible résolution, il est "
"recommandé d'utiliser le flux basse résolution pour la détection de "
"mouvement et le flux haute résolution pour l'enregistrement (voir URL HAUTE "
"RÉSOLUTION DE LA CAMÉRA RÉSEAU)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Main camera stream"
msgstr "Flux principal de la caméra"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Low resolution camera stream"
msgstr "Flux basse résolution de la caméra"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Go2RTC stream"
msgstr "Flux Go2RTC"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "NETWORK CAMERA PARAMS"
msgstr "PARAMÈTRES DE LA CAMÉRA RÉSEAU"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Comma separated list of configuration parameters. Format is: "
"option=value,option2=value2."
msgstr ""
"Liste de paramètres de configuration séparés par des virgules. Format : "
"option=valeur,option2=valeur2."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "NETWORK CAMERA HIGH RESOLUTION URL"
msgstr "URL HAUTE RÉSOLUTION DE LA CAMÉRA RÉSEAU"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Network camera high resolution URL. It is recommended to use the high "
"resolution stream of your camera for recording, and the low resolution "
"stream for motion detection (see NETWORK CAMERA URL)."
msgstr ""
"URL haute résolution de la caméra réseau. Il est recommandé d'utiliser le "
"flux haute résolution de votre caméra pour l'enregistrement, et le flux "
"basse résolution pour la détection de mouvement (voir URL DE LA CAMÉRA "
"RÉSEAU)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "NETWORK CAMERA HIGH RESOLUTION PARAMS"
msgstr "PARAMÈTRES HAUTE RÉSOLUTION DE LA CAMÉRA RÉSEAU"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "NETWORK CAMERA AUTHENTICATION"
msgstr "AUTHENTIFICATION DE LA CAMÉRA RÉSEAU"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Username and password for the network camera specified as username:password."
msgstr ""
"Nom d'utilisateur et mot de passe de la caméra réseau, au format "
"utilisateur:motdepasse."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "WIDTH"
msgstr "LARGEUR"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The width of the image in pixels. Must be a multiple of 8. For better "
"performance, width and height parameters must match the resolution of the "
"camera."
msgstr ""
"Largeur de l'image en pixels. Doit être un multiple de 8. Pour de meilleures "
"performances, la largeur et la hauteur doivent correspondre à la résolution "
"de la caméra."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "HEIGHT"
msgstr "HAUTEUR"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The height of the image in pixels. Must be a multiple of 8. For better "
"performance, width and height parameters must match the resolution of the "
"camera."
msgstr ""
"Hauteur de l'image en pixels. Doit être un multiple de 8. Pour de meilleures "
"performances, la largeur et la hauteur doivent correspondre à la résolution "
"de la caméra."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
#: views/includes/camera/edit/form.inc.php
#: views/includes/panels/camera/add.inc.php
msgid "FRAME RATE"
msgstr "FRÉQUENCE D'IMAGES"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The number of frames to be processed per second for motion detection. For "
"better performance, the framerate parameter must match the framerate of the "
"camera. If you are using a network camera with two streams (low and high "
"resolution), the framerate parameter must match the framerate of the low "
"resolution stream (in fact the stream used for motion detection)."
msgstr ""
"Nombre d'images à traiter par seconde pour la détection de mouvement. Pour "
"de meilleures performances, ce paramètre doit correspondre à la fréquence "
"d'images de la caméra. Si vous utilisez une caméra réseau avec deux flux "
"(basse et haute résolution), ce paramètre doit correspondre à la fréquence "
"d'images du flux basse résolution (c'est-à-dire le flux utilisé pour la "
"détection de mouvement)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
#: views/includes/camera/edit/form.inc.php
msgid "ROTATE"
msgstr "ROTATION"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Rotate image the given number of degrees."
msgstr "Fait pivoter l'image du nombre de degrés indiqué."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "DEVICE TIMEOUT"
msgstr "DÉLAI D'EXPIRATION DU PÉRIPHÉRIQUE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Number of seconds that elapse before the device is deemed to be lost."
msgstr ""
"Nombre de secondes avant que le périphérique soit considéré comme perdu."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "WATCHDOG TIMEOUT"
msgstr "DÉLAI DU WATCHDOG"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Number of seconds that elapse before a camera is deemed to be unresponsive "
"and Motion triggers a watchdog timeout and begins to force the camera to "
"shut down."
msgstr ""
"Nombre de secondes avant qu'une caméra soit considérée comme ne répondant "
"plus. Motion déclenche alors le watchdog et commence à forcer l'arrêt de la "
"caméra."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "WATCHDOG KILL"
msgstr "ARRÊT FORCÉ DU WATCHDOG"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Number of seconds that elapse after the watchdog_tmo that Motion waits until "
"the kill processes begin to force the camera to shut down."
msgstr ""
"Nombre de secondes, après watchdog_tmo, que Motion attend avant de tuer les "
"processus pour forcer l'arrêt de la caméra."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOTION DETECTION & IMAGE PROCESSING"
msgstr "DÉTECTION DE MOUVEMENT & TRAITEMENT D'IMAGE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "EMULATE MOTION DETECTION"
msgstr "ÉMULER LA DÉTECTION DE MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Always save images even if there was no motion (motion emulation)."
msgstr ""
"Toujours enregistrer les images, même en l'absence de mouvement (émulation "
"de mouvement)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PAUSE MOTION DETECTION"
msgstr "METTRE EN PAUSE LA DÉTECTION"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Pause detection at start up."
msgstr "Mettre la détection en pause au démarrage."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOTION DETECTION SENSITIVITY"
msgstr "SENSIBILITÉ DE LA DÉTECTION DE MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Minimum number of changed pixels that triggers an event."
msgstr "Nombre minimum de pixels modifiés pour déclencher un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "THRESHOLD MAXIMUM"
msgstr "SEUIL MAXIMUM"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Maximum number of changed pixels that triggers an event. If the number of "
"changed pixels is over the threshold maximum, no event is triggered. A value "
"of zero disables threshold_maximum."
msgstr ""
"Nombre maximum de pixels modifiés pour déclencher un événement. Si le nombre "
"de pixels modifiés dépasse ce seuil, aucun événement n'est déclenché. Une "
"valeur de zéro désactive threshold_maximum."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "THRESHOLD TUNE"
msgstr "AJUSTEMENT DU SEUIL"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Continuously adjust the threshold for triggering an event."
msgstr "Ajuster en continu le seuil de déclenchement d'un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "THRESHOLD SDEVX"
msgstr "SEUIL SDEVX"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The maximum standard deviation of the changed pixels in the x (width) axis."
msgstr "Écart type maximum des pixels modifiés sur l'axe x (largeur)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "THRESHOLD SDEVY"
msgstr "SEUIL SDEVY"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The maximum standard deviation of the changed pixels in the y (height) axis."
msgstr "Écart type maximum des pixels modifiés sur l'axe y (hauteur)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "THRESHOLD SDEVXY"
msgstr "SEUIL SDEVXY"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The maximum standard deviation of the changed pixels in the x (width) and "
"y(height) axis."
msgstr ""
"Écart type maximum des pixels modifiés sur les axes x (largeur) et y "
"(hauteur)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "THRESHOLD RATIO"
msgstr "RATIO DU SEUIL"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The maximum ratio comparing the pixels that went white to black and vice "
"versa."
msgstr "Ratio maximum entre les pixels passés du blanc au noir et inversement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "THRESHOLD RATIO CHANGE"
msgstr "VARIATION DU RATIO DU SEUIL"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "The minimum change in the ratio to trigger a event."
msgstr "Variation minimum du ratio pour déclencher un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "NOISE LEVEL"
msgstr "NIVEAU DE BRUIT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The minimum amount of change in a single pixel before it is counted towards "
"the threshold value."
msgstr ""
"Variation minimum d'un pixel avant qu'il soit pris en compte dans le calcul "
"du seuil."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "NOISE TUNE"
msgstr "AJUSTEMENT DU BRUIT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Continuously adjust the noise_level parameter."
msgstr "Ajuster en continu le paramètre noise_level."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "DESPECKLE FILTER"
msgstr "FILTRE ANTI-PARASITES"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Despeckle the image using combinations of (E/e)rode or (D/d)ilate. And "
"ending with optional (l)abeling. This reduces noise in the motion image. "
"Adding a trailing l enables labeling in which only the largest section "
"section is used to calculate the threshold. Typical value is EedDl."
msgstr ""
"Nettoie l'image en combinant des opérations d'érosion (E/e) ou de dilatation "
"(D/d), suivies éventuellement d'un étiquetage (l). Cela réduit le bruit dans "
"l'image de mouvement. Ajouter un l final active l'étiquetage : seule la plus "
"grande zone est alors utilisée pour calculer le seuil. Valeur typique : "
"EedDl."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MINIMUM MOTION FRAMES"
msgstr "NOMBRE MINIMUM D'IMAGES EN MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The number of frames that must contain motion in order to trigger an event."
msgstr ""
"Nombre d'images devant contenir du mouvement pour déclencher un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "EVENT GAP"
msgstr "INTERVALLE ENTRE ÉVÉNEMENTS"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "The seconds of no motion detection that triggers the end of an event."
msgstr ""
"Nombre de secondes sans mouvement détecté qui marque la fin d'un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PRE CAPTURE"
msgstr "PRÉ-CAPTURE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The number of pre-captured (buffered) frames to be captured before an event."
msgstr ""
"Nombre d'images pré-capturées (en mémoire tampon) à enregistrer avant un "
"événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "POST CAPTURE"
msgstr "POST-CAPTURE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "The number of frames to be captured after an event has ended."
msgstr "Nombre d'images à capturer après la fin d'un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
#: views/includes/camera/edit/form.inc.php
msgid "TEXT LEFT"
msgstr "TEXTE À GAUCHE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Text to be written on the left of the image."
msgstr "Texte à afficher à gauche de l'image."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
#: views/includes/camera/edit/form.inc.php
msgid "TEXT RIGHT"
msgstr "TEXTE À DROITE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Text to be written on the right of the image."
msgstr "Texte à afficher à droite de l'image."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "TEXT CHANGES"
msgstr "AFFICHER LES CHANGEMENTS"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Show the number of pixels that changed in the upper right corner."
msgstr "Afficher le nombre de pixels modifiés dans le coin supérieur droit."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "TEXT SCALE"
msgstr "TAILLE DU TEXTE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Text size."
msgstr "Taille du texte."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "AREA DETECT"
msgstr "DÉTECTION PAR ZONE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Detect motion in predefined areas (1 - 9) and when Motion is detected in the "
"area, execute the script. This option is only to execute the on_area_detect "
"script."
msgstr ""
"Détecter le mouvement dans des zones prédéfinies (1 à 9) et exécuter le "
"script lorsqu'un mouvement est détecté dans la zone. Cette option sert "
"uniquement à exécuter le script on_area_detect."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MASK FILE"
msgstr "FICHIER DE MASQUE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and filename for the masking pgm file. If needed, the mask "
"will be resized to match the width and height of the image. The areas in the "
"mask file colored black will be excluded from motion detection. Shades of "
"grey on the mask will diminish the detection while areas of white will not "
"have any impact on motion detection."
msgstr ""
"Chemin complet et nom du fichier pgm de masque. Si nécessaire, le masque "
"sera redimensionné pour correspondre à la largeur et à la hauteur de "
"l'image. Les zones noires du masque sont exclues de la détection de "
"mouvement. Les nuances de gris atténuent la détection, tandis que les zones "
"blanches n'ont aucun impact."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MASK PRIVACY"
msgstr "MASQUE DE CONFIDENTIALITÉ"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and filename for the privacy masking pgm file. This mask "
"completely removes the indicated sections of the image."
msgstr ""
"Chemin complet et nom du fichier pgm de masque de confidentialité. Ce masque "
"supprime totalement les zones indiquées de l'image."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "SMART MASK SPEED"
msgstr "VITESSE DU MASQUE INTELLIGENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The smartmask is intended to be a dynamic, self-learning mask to decrease "
"sensitivity in areas with frequent motion. The speed specified by this "
"parameter is how quickly the mask gets adjusted. Zero disables the smart "
"mask."
msgstr ""
"Le masque intelligent est un masque dynamique et auto-apprenant qui réduit "
"la sensibilité dans les zones où le mouvement est fréquent. Ce paramètre "
"définit la vitesse d'ajustement du masque. Zéro désactive le masque "
"intelligent."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "LOCATE MOTION MODE"
msgstr "MODE DE LOCALISATION DU MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Locate and draw around/on the moving object. Preview only applies to "
"pictures."
msgstr ""
"Localiser l'objet en mouvement et dessiner autour/dessus. Le mode preview "
"s'applique uniquement aux images."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "LOCATE MOTION STYLE"
msgstr "STYLE DE LOCALISATION DU MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Set the look and style of the locate mode."
msgstr "Définir l'apparence du mode de localisation."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "LIGHTSWITCH PERCENT"
msgstr "POURCENTAGE DE CHANGEMENT DE LUMIÈRE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The minimum change in the portion of the image that will trigger a "
"lightswitch condition."
msgstr ""
"Variation minimum de la portion de l'image qui déclenche une condition de "
"changement de lumière."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "LIGHTSWITCH FRAMES"
msgstr "IMAGES IGNORÉES APRÈS CHANGEMENT DE LUMIÈRE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The number of frames to ignore when the lightswitch condition is triggered "
"(see above)."
msgstr ""
"Nombre d'images à ignorer lorsqu'un changement de lumière est détecté (voir "
"ci-dessus)."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "STATIC OBJECT TIME"
msgstr "DURÉE D'UN OBJET STATIQUE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Number of seconds before a new object is included in the reference image."
msgstr ""
"Nombre de secondes avant qu'un nouvel objet soit intégré à l'image de "
"référence."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIES GENERAL SETTINGS"
msgstr "PARAMÈTRES GÉNÉRAUX DES VIDÉOS"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE OUTPUT"
msgstr "ENREGISTREMENT VIDÉO"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Encode movies of the motion events."
msgstr "Encoder des vidéos des événements de mouvement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE OUTPUT MOTION"
msgstr "VIDÉO DU MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Encode movies that show the pixels that changed. If labeling is enabled via "
"the despeckle option, the largest area will be in blue. If smartmask is "
"enabled it will be shown in red."
msgstr ""
"Encoder des vidéos montrant les pixels modifiés. Si l'étiquetage est activé "
"via l'option despeckle, la plus grande zone apparaît en bleu. Si le masque "
"intelligent est activé, il apparaît en rouge."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE MAX TIME"
msgstr "DURÉE MAXIMUM DES VIDÉOS"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The maximum length of a movie in seconds. Set this to zero for unlimited "
"length."
msgstr ""
"Durée maximum d'une vidéo en secondes. Mettre à zéro pour une durée "
"illimitée."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE BPS"
msgstr "DÉBIT DES VIDÉOS"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Bitrate to use in encoding of movies. This option is ignored if "
"movie_quality is specified."
msgstr ""
"Débit utilisé pour l'encodage des vidéos. Cette option est ignorée si "
"movie_quality est défini."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE QUALITY"
msgstr "QUALITÉ DES VIDÉOS"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"A value of 0 disables this option while values 1 - 100 change the quality of "
"the movie. The value of 1 means worst quality and 100 is the best quality. "
"High values of this option (e.g. 100) may cause difficulty with some players."
msgstr ""
"Une valeur de 0 désactive cette option, les valeurs de 1 à 100 modifient la "
"qualité de la vidéo. 1 correspond à la pire qualité et 100 à la meilleure. "
"Des valeurs élevées (ex : 100) peuvent poser problème avec certains lecteurs."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE CONTAINER"
msgstr "CONTENEUR VIDÉO"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Container/Codec to be used for the video. Preferred codec can be appended "
"e.g. <code>mkv:libx265</code>"
msgstr ""
"Conteneur/codec à utiliser pour la vidéo. Le codec souhaité peut être "
"ajouté, ex : <code>mkv:libx265</code>"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE RETAIN"
msgstr "CONSERVER LA VIDÉO"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Retain movie only if the secondary detection occurred."
msgstr "Conserver la vidéo uniquement si une détection secondaire a eu lieu."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE PASSTHROUGH"
msgstr "VIDÉO EN PASSTHROUGH"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"When using a RTSP, RTMP, mjpeg and some V4l2 cameras, create movie files "
"with the packets obtained directly from the camera."
msgstr ""
"Avec les caméras RTSP, RTMP, mjpeg et certaines caméras V4l2, créer les "
"fichiers vidéo directement à partir des paquets reçus de la caméra."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE FILENAME"
msgstr "NOM DES FICHIERS VIDÉO"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The file name and optionally the path for the movie relative to target_dir. "
"The file extension is automatically added based upon the container."
msgstr ""
"Nom du fichier, et éventuellement chemin, de la vidéo, relatif à target_dir. "
"L'extension est ajoutée automatiquement en fonction du conteneur."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE EXTPIPE USE"
msgstr "UTILISER UN PIPE EXTERNE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Specifies whether to send the pictures to pipe for external encoding into a "
"movie."
msgstr ""
"Indique s'il faut envoyer les images vers un pipe pour un encodage externe "
"en vidéo."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "MOVIE EXTPIPE"
msgstr "PIPE EXTERNE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "The program name and options for processing the images."
msgstr "Nom du programme et options pour le traitement des images."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "VIDEO PIPE"
msgstr "PIPE VIDÉO"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The video4linux video loopback device for normal images. The device would be "
"specified in the format like /dev/video1"
msgstr ""
"Périphérique de bouclage video4linux pour les images normales, au format /"
"dev/video1"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "VIDEO PIPE MOTION"
msgstr "PIPE VIDÉO DU MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The video4linux video loopback device for motion images. The device would be "
"specified in the format like /dev/video1"
msgstr ""
"Périphérique de bouclage video4linux pour les images de mouvement, au "
"format /dev/video1"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PICTURES GENERAL SETTINGS"
msgstr "PARAMÈTRES GÉNÉRAUX DES IMAGES"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PICTURE OUTPUT"
msgstr "ENREGISTREMENT DES IMAGES"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"'on' saves all motion images during an event. 'first' saves only the first "
"image that detected motion. 'best' saves image with most changed pixels."
msgstr ""
"'on' enregistre toutes les images de mouvement pendant un événement. 'first' "
"enregistre uniquement la première image ayant détecté un mouvement. 'best' "
"enregistre l'image avec le plus de pixels modifiés."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PICTURE OUTPUT MOTION"
msgstr "IMAGES DU MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"Save the motion(debug) pictures with the pixels that change as a graytone "
"image. If labeling is enabled via the despeckele option, the largest area "
"will be blue and areas in red are those determined by the smartmask option."
msgstr ""
"Enregistrer les images de mouvement (debug) avec les pixels modifiés en "
"niveaux de gris. Si l'étiquetage est activé via l'option despeckle, la plus "
"grande zone apparaît en bleu et les zones déterminées par le masque "
"intelligent en rouge."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PICTURE TYPE"
msgstr "TYPE D'IMAGE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "The type of picture file to output."
msgstr "Type de fichier image à générer."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PICTURE QUALITY"
msgstr "QUALITÉ DES IMAGES"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The image quality for the jpeg or webp images in percent. The value of 1 is "
"worst and 100 is best."
msgstr ""
"Qualité des images jpeg ou webp en pourcentage. 1 correspond à la pire "
"qualité et 100 à la meilleure."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PICTURE EXIF"
msgstr "EXIF DES IMAGES"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "The text for the JPEG EXIF comment with the EXIF timestamp."
msgstr "Texte du commentaire EXIF JPEG, avec l'horodatage EXIF."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "PICTURE FILENAME"
msgstr "NOM DES FICHIERS IMAGE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The filename for the picture files. The default filename is %v-%Y%m%d%H%M%S-"
"%q."
msgstr "Nom des fichiers image. Le nom par défaut est %v-%Y%m%d%H%M%S-%q."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "SCRIPT EXECUTION"
msgstr "EXÉCUTION DE SCRIPTS"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON EVENT START"
msgstr "AU DÉBUT D'UN ÉVÉNEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed at the "
"start of an event."
msgstr ""
"Chemin complet et nom du programme/script à exécuter au début d'un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON EVENT END"
msgstr "À LA FIN D'UN ÉVÉNEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed at the end "
"of an event."
msgstr ""
"Chemin complet et nom du programme/script à exécuter à la fin d'un événement."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON PICTURE SAVE"
msgstr "À L'ENREGISTREMENT D'UNE IMAGE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when a "
"picture is saved."
msgstr ""
"Chemin complet et nom du programme/script à exécuter lorsqu'une image est "
"enregistrée."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON MOTION DETECTED"
msgstr "À LA DÉTECTION D'UN MOUVEMENT"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when motion "
"is detected."
msgstr ""
"Chemin complet et nom du programme/script à exécuter lorsqu'un mouvement est "
"détecté."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON AREA DETECTED"
msgstr "À LA DÉTECTION DANS UNE ZONE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when motion "
"is detected in the area specified."
msgstr ""
"Chemin complet et nom du programme/script à exécuter lorsqu'un mouvement est "
"détecté dans la zone spécifiée."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON MOVIE START"
msgstr "AU DÉBUT D'UNE VIDÉO"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed at the "
"creation of a movie."
msgstr ""
"Chemin complet et nom du programme/script à exécuter à la création d'une "
"vidéo."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON MOVIE END"
msgstr "À LA FIN D'UNE VIDÉO"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when a "
"movie ends."
msgstr ""
"Chemin complet et nom du programme/script à exécuter à la fin d'une vidéo."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON CAMERA LOST"
msgstr "À LA PERTE DE LA CAMÉRA"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when the "
"camera is no longer detected."
msgstr ""
"Chemin complet et nom du programme/script à exécuter lorsque la caméra n'est "
"plus détectée."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON CAMERA FOUND"
msgstr "AU RETOUR DE LA CAMÉRA"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when a "
"previously lost camera is active again."
msgstr ""
"Chemin complet et nom du programme/script à exécuter lorsqu'une caméra "
"précédemment perdue est de nouveau active."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON SECONDARY DETECT"
msgstr "À LA DÉTECTION SECONDAIRE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when "
"secondary detection occurs."
msgstr ""
"Chemin complet et nom du programme/script à exécuter lorsqu'une détection "
"secondaire a lieu."

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "ON SOUND ALERT"
msgstr "À UNE ALERTE SONORE"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid ""
"The full path and file name of the program/script to be executed when a "
"sound alert is triggered."
msgstr ""
"Chemin complet et nom du programme/script à exécuter lorsqu'une alerte "
"sonore est déclenchée."

#: controllers/Layout/Table/Render.php
msgid "Previous"
msgstr "Précédent"

#: controllers/Layout/Table/Render.php
msgid "Next"
msgstr "Suivant"

#: controllers/Layout/Table/vars/motion/events.vars.inc.php
