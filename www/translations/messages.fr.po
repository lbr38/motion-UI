msgstr "DÉTECTION DE MOUVEMENT"

#: views/includes/camera/edit/form.inc.php
#: views/includes/panels/camera/add.inc.php
msgid "Enable motion detection for this camera."
msgstr "Activer la détection de mouvement pour cette caméra."

#: views/includes/camera/edit/form.inc.php
