#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "CAMERA DEVICE SETTINGS"
msgstr "KAMERAGERÄT-EINSTELLUNGEN"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "DEVICE ID"
msgstr "GERÄTE-ID"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Camera device ID"
msgstr "Geräte-ID der Kamera"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "DEVICE NAME"
msgstr "GERÄTENAME"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
msgid "Camera device name"
msgstr "Gerätename der Kamera"

#: controllers/Layout/Panel/vars/motion/edit.vars.inc.php
