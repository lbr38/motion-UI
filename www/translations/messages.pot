#: views/includes/panels/camera/add.inc.php
msgid ""
"Device path like /dev/video0 or URL like http://... or rtsp://... are "
"supported."
msgstr ""

#: views/includes/camera/edit/form.inc.php
msgid "e.g. /dev/video0 or http(s)://... or rtsp://..."
msgstr ""

#: views/includes/camera/edit/form.inc.php
#: views/includes/panels/camera/add.inc.php
msgid "RESOLUTION"
msgstr ""

#: views/includes/camera/edit/form.inc.php
#: views/includes/panels/camera/add.inc.php
msgid "The selected resolution must match the resolution of the camera."
msgstr ""

